{
  "appId": "com.taskflow.pwa",
  "appName": "TaskFlow",
  "webDir": "www",
  "ios": {
    "backgroundColor": "#0a0a14",
    "allowsLinkPreview": false,
    "scrollEnabled": false,
    "contentInset": "always"
  },
  "server": {
    "allowNavigation": ["*"]
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 0,
      "backgroundColor": "#0a0a14",
      "showSpinner": false
    },
    "LocalNotifications": {
      "smallIcon": "ic_stat_icon",
      "iconColor": "#ff6b35",
      "sound": "default"
    }
  }
}
